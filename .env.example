# Пример настроек. Скопируй этот файл в .env и отредактируй:
#   Windows:   copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Программа читает ТОЛЬКО файл .env (сам .env.example игнорируется).

# Провайдер:
#   "openai" — любой OpenAI-совместимый API (включая бесплатные);
#   "ollama"  — локальный сервер (нужна установка Ollama).
LLM_PROVIDER=openai

# ============ БЕСПЛАТНЫЙ ВАРИАНТ (по умолчанию): Groq + Jina ============
# Генерация ответов — через Groq, векторы — через Jina AI.
# Оба ключа бесплатные, без карты. Впиши свои ключи в две строки ниже.
#   Groq: https://console.groq.com   (ключ вида gsk_...)
#   Jina: https://jina.ai/embeddings (ключ вида jina_...)

LLM_API_KEY=gsk_ВСТАВЬ_СВОЙ_КЛЮЧ_GROQ
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

EMBEDDING_API_KEY=jina_ВСТАВЬ_СВОЙ_КЛЮЧ_JINA
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3

# ============ ВАРИАНТ: один API на всё (например, чистый OpenAI) ============
# Если у тебя один ключ для генерации и векторов — раскомментируй эти три строки
# и заполни. В этом случае LLM_API_KEY / EMBEDDING_API_KEY можно не трогать:
# программа возьмёт OPENAI_API_KEY.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============ ВАРИАНТ: локально через Ollama (без интернета) ============
# Чтобы использовать, поменяй LLM_PROVIDER=ollama и раскомментируй три строки.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============ Общие параметры (можно не трогать) ============
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=4
TEMPERATURE=0.2
