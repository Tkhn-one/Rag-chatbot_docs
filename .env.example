# Пример переменных окружения. Скопируй в файл .env и отредактируй.

# "openai" — любой OpenAI-совместимый API (включая бесплатные), "ollama" — локальный сервер
LLM_PROVIDER=openai

# --- OpenAI (или любой OpenAI-совместимый API) ---
# Если хватает одного ключа и стандартного api.openai.com — достаточно OPENAI_API_KEY.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Бесплатные OpenAI-совместимые API (пример: Groq + Jina) ---
# Генерация через Groq (бесплатно, без карты): https://console.groq.com
# LLM_API_KEY=gsk_твой_ключ_groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Эмбеддинги через Jina AI (бесплатный ключ): https://jina.ai/embeddings
# EMBEDDING_API_KEY=jina_твой_ключ
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_MODEL=jina-embeddings-v3

# Альтернативы для генерации (тоже OpenAI-совместимы):
# OpenRouter — https://openrouter.ai (модель: deepseek/deepseek-chat или другая с суффиксом :free)
# DeepSeek — https://platform.deepseek.com (модель: deepseek-chat)

# Имена моделей при необходимости переопределяются отдельно
LLM_MODEL=
EMBEDDING_MODEL=

# --- Ollama (используется только при LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Разбивка на чанки (символы) ---
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Сколько фрагментов из базы подаём модели на каждый вопрос
TOP_K=4

# Температура генерации (0 — строго, 1 — креативно)
TEMPERATURE=0.2
