# Пример переменных окружения. Скопируй в файл .env и отредактируй.

# "openai" — платный API от OpenAI, "ollama" — бесплатный локальный сервер
LLM_PROVIDER=ollama

# --- OpenAI (используется только при LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (используется только при LLM_PROVIDER=ollama) ---
# Адрес локального сервера Ollama, менять обычно не нужно
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Разбивка на чанки (символы) ---
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Сколько фрагментов из базы подаём модели на каждый вопрос
TOP_K=4

# Температура генерации (0 — строго, 1 — креативно)
TEMPERATURE=0.2
